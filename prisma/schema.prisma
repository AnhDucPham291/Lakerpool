generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app; direct (unpooled) connection for `prisma db push`.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

// Lifecycle of a rider's trip request in the rider/driver apps.
enum TripStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  studentVerified Boolean @default(false)
  // scrypt hash (see src/lib/auth.ts). Null for profiles created before passwords existed.
  passwordHash  String?
  sessions      Session[]
  // Shared with the other party only after a driver accepts a trip.
  phone         String?
  // Driver app: a user becomes a driver by adding vehicle details.
  isDriver      Boolean  @default(false)
  vehicleName   String?
  vehicleColor  String?
  licensePlate  String?
  createdAt     DateTime @default(now())
  driverRides   Ride[]   @relation("DriverRides")
  bookings      Booking[]
  reviewsGiven  Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  reports       SafetyReport[]
  messages      Message[]
  tripRequests  TripRequest[] @relation("RiderTrips")
  tripsDriven   TripRequest[] @relation("DriverTrips")
  tripMessages  TripMessage[]
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored here.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
}

// A rider asks for a ride; one driver can accept it.
model TripRequest {
  id              String     @id @default(cuid())
  riderId         String
  rider           User       @relation("RiderTrips", fields: [riderId], references: [id])
  driverId        String?
  driver          User?      @relation("DriverTrips", fields: [driverId], references: [id])
  origin          String
  destination     String
  // Simplified route as [[latitude, longitude], ...] for the map preview.
  routePath       Json
  distanceMiles   Float
  durationMinutes Int
  departureAt     DateTime
  // People in the rider's group who split the fare.
  riders          Int        @default(1)
  totalFare       Float
  farePerRider    Float
  notes           String?
  status          TripStatus @default(OPEN)
  acceptedAt      DateTime?
  createdAt       DateTime   @default(now())
  messages        TripMessage[]
  @@index([status, departureAt])
  @@index([riderId])
  @@index([driverId])
}

model TripMessage {
  id        String      @id @default(cuid())
  tripId    String
  trip      TripRequest @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime    @default(now())
  @@index([tripId, createdAt])
}

model Ride {
  id              String   @id @default(cuid())
  driverId        String
  driver          User     @relation("DriverRides", fields: [driverId], references: [id])
  origin          String
  destination     String
  departureAt     DateTime
  pickupDetails   String
  dropoffDetails  String
  vehicleType     String
  vehicleName     String?
  vehicleColor    String?
  seatsTotal      Int
  seatsAvailable  Int
  estimatedPrice  Float
  stops           Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  bookings        Booking[]
  @@index([origin, destination, departureAt])
}

model Booking {
  id          String @id @default(cuid())
  rideId      String
  ride        Ride   @relation(fields: [rideId], references: [id])
  passengerId String
  passenger   User   @relation(fields: [passengerId], references: [id])
  seats       Int    @default(1)
  pricePerPassenger Float
  status      BookingStatus @default(PENDING)
  createdAt   DateTime @default(now())
  @@unique([rideId, passengerId])
}

model Review {
  id         String @id @default(cuid())
  reviewerId String
  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  driverId   String
  driver     User   @relation("ReviewsReceived", fields: [driverId], references: [id])
  rideId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  @@index([driverId])
}

model SafetyReport {
  id          String @id @default(cuid())
  reporterId  String
  reporter    User   @relation(fields: [reporterId], references: [id])
  rideId      String
  category    String
  description String
  severity    ReportSeverity
  status      String @default("OPEN")
  createdAt   DateTime @default(now())
}

model Message {
  id        String @id @default(cuid())
  senderId  String
  sender    User   @relation(fields: [senderId], references: [id])
  rideId    String
  body      String
  createdAt DateTime @default(now())
}
