# Postgres connection strings (for example from Neon: https://neon.tech).
# On Vercel, connecting a Neon database under Storage adds both variables automatically.
# Pooled connection, used by the app at runtime:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection, used by `prisma db push`:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
